<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity 없이 Assets/IFS의 C#을 컴파일한다. netstandard2.1 = Unity 2021.2+의 API 수준, C# 9 = Unity 2022.3의 언어 수준 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>IFS.SceneSpec</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/IFS/Runtime/**/*.cs" />
    <Compile Include="../../Assets/IFS/Editor/**/*.cs" />
    <Compile Include="Stubs/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- com.unity.nuget.newtonsoft-json 3.2.x = Newtonsoft.Json 13.0.x -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
