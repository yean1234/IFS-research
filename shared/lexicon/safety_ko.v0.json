{
  "lexiconId": "safety-ko",
  "lexiconVersion": "0.1.0",
  "status": "draft — 연구팀·IRB 검토 전",
  "language": "ko",
  "notes": [
    "패턴은 파이썬 정규식이다. 비교 전에 입력을 NFC 정규화하고 연속 공백을 하나로 줄인다.",
    "L1 입력 검사는 이 사전과 가드 모델 중 하나라도 걸리면 발동한다(재현율 우선). 「IFS 이론이란?」 5절.",
    "심상 묘사에는 몸 은유가 많아 오탐이 많다. 그래서 명확한 의도 표현만 위기 대응(crisis)으로 보내고, 은유·모호 표현은 가벼운 확인 문구(soft_check)로 보낸다.",
    "'가슴이 눌리는 느낌', '목이 막힌 느낌', '조이는 느낌'처럼 2D 설문 선택지에 있던 흔한 신체감각 묘사는 넣지 않는다. 확인 문구가 너무 자주 나오면 그 자체가 부담이 된다."
  ],

  "crisis": {
    "tiers": {
      "crisis": {
        "action": "crisis",
        "alertResearcher": true,
        "description": "자신이나 타인을 해치려는 명확한 의도 표현. LLM을 호출하지 않고 고정 문구(109, 1577-0199, 연구자 연락처)를 낸 뒤 세션을 멈춘다(L4).",
        "patterns": [
          { "id": "suicide_word", "re": "자살" },
          { "id": "self_harm_word", "re": "자해" },
          { "id": "want_to_die", "re": "죽고\\s*싶" },
          { "id": "want_to_die_2", "re": "죽어\\s*버리고\\s*싶|죽어버리고\\s*싶" },
          { "id": "want_to_die_3", "re": "죽었으면\\s*좋겠|차라리\\s*죽" },
          { "id": "end_life", "re": "목숨을\\s*끊|생을\\s*마감|삶을\\s*끝내|극단적\\s*(인\\s*)?선택" },
          { "id": "method_hanging", "re": "목을\\s*매" },
          { "id": "method_cutting", "re": "손목을\\s*(긋|그어|그을)|긋고\\s*싶" },
          { "id": "method_jump", "re": "뛰어내리고\\s*싶|투신" },
          { "id": "method_overdose", "re": "약을\\s*(다|잔뜩|한꺼번에)\\s*먹" },
          { "id": "farewell_note", "re": "유서" },
          { "id": "harm_others", "re": "죽이고\\s*싶|죽여\\s*버리|해치고\\s*싶|때리고\\s*싶|다치게\\s*하고\\s*싶" },
          { "id": "harm_self", "re": "나를\\s*(해치|다치게\\s*하)고\\s*싶|스스로를\\s*해치" }
        ]
      },
      "ambiguous": {
        "action": "soft_check",
        "alertResearcher": true,
        "description": "수동적 사고일 수 있는 모호한 표현. 확인 문구를 내고 연구자에게 알린다. 노션 문서는 '사라지고 싶다'를 은유 오탐 예로 들지만, 수동적 자살 사고일 수도 있어 연구자 알림을 함께 건다.",
        "patterns": [
          { "id": "disappear", "re": "사라지고\\s*싶|없어지고\\s*싶|사라져\\s*버리고\\s*싶" },
          { "id": "not_want_live", "re": "살기\\s*싫|살고\\s*싶지\\s*않|그만\\s*살고\\s*싶|사는\\s*게\\s*의미\\s*없" },
          { "id": "not_wake", "re": "깨어나고\\s*싶지\\s*않|안\\s*깨어났으면|잠들어서\\s*안\\s*깨" },
          { "id": "not_born", "re": "태어나지\\s*말았" },
          { "id": "give_up_all", "re": "다\\s*포기하고\\s*싶|다\\s*끝내고\\s*싶|모든\\s*걸\\s*끝내" },
          { "id": "jump_word", "re": "뛰어내리" },
          { "id": "unbearable", "re": "견딜\\s*수\\s*(가\\s*)?없|버틸\\s*수\\s*(가\\s*)?없|더는\\s*못\\s*버티" }
        ]
      },
      "metaphor": {
        "action": "soft_check",
        "alertResearcher": false,
        "description": "심상 묘사에 자주 나오는 강한 몸 은유. 스토리보드 13′의 '숨이 막히는 느낌이 올라와요' → controversial → [계속][그만] 확인과 같다.",
        "patterns": [
          { "id": "cannot_breathe", "re": "숨이?\\s*막히|숨을?\\s*못\\s*쉬|숨\\s*쉬기\\s*(가\\s*)?힘들|질식" },
          { "id": "burst", "re": "터질\\s*것\\s*같|터져\\s*버릴\\s*것|폭발할\\s*것\\s*같" },
          { "id": "dying_intensifier", "re": "죽을\\s*것\\s*같|죽겠" },
          { "id": "going_crazy", "re": "미칠\\s*것\\s*같|미쳐\\s*버릴" },
          { "id": "collapse", "re": "무너질\\s*것\\s*같|무너져\\s*내리" },
          { "id": "tearing", "re": "찢어질\\s*것\\s*같|찢어지는" }
        ]
      }
    }
  },

  "control": {
    "stop": {
      "description": "메시지 전체가 중단 요청일 때만 멈춘다('그만큼' 같은 묘사는 걸리지 않게). 손바닥 펴기 제스처·[그만] 버튼과 같은 효과.",
      "wholeMessagePatterns": [
        "(이제\\s*)?그만(\\s*할래요|\\s*할게요|\\s*하고\\s*싶어요|\\s*해\\s*주세요|\\s*할래|\\s*하자|요)?",
        "멈춰(\\s*주세요|요)?|멈출래요|멈추고\\s*싶어요",
        "중단(\\s*할래요|\\s*할게요|\\s*해\\s*주세요|\\s*하고\\s*싶어요)?",
        "종료(\\s*할래요|\\s*할게요|\\s*해\\s*주세요)?",
        "끝낼래요|끝낼게요|끝내고\\s*싶어요|끝내\\s*주세요",
        "stop|quit"
      ]
    },
    "noMore": {
      "description": "더 없음·모름·넘어가기. 압박하지 않고 다음 단계로 넘어간다. 짧은 메시지에서만 적용한다(maxChars).",
      "maxChars": 16,
      "patterns": [
        "^(아니요|아뇨|아니)?\\s*(없어요|없습니다|없음|없네요|없는\\s*것\\s*같아요|없어)$",
        "(더|딱히|별로|특별히)(는|도|이상)?\\s*없",
        "그게\\s*(다|전부)",
        "모르겠|잘\\s*모르|모름|글쎄",
        "떠오르(지\\s*않|는\\s*(게|것이?)\\s*없)|생각이\\s*안\\s*나",
        "넘어갈게요|넘어가\\s*주세요|넘어갈래요|다음으로|패스|pass|skip",
        "말하고\\s*싶지\\s*않|답하고\\s*싶지\\s*않|대답하고\\s*싶지\\s*않"
      ]
    },
    "delegation": {
      "description": "참여자가 판단을 맡기는 표현(규칙 8). 질문을 바꾸지는 않고 연구자 화면과 로그에 표시한다.",
      "patterns": [
        "정해\\s*주세요|골라\\s*주세요|알려\\s*주세요|말해\\s*주세요",
        "맞나요\\?|맞아요\\?|맞죠\\?|그런가요\\?",
        "어떻게\\s*생각하세요|뭐라고\\s*해야|어떤\\s*게\\s*좋을까"
      ]
    }
  },

  "depth": {
    "description": "L5 깊이 제한. 6F는 보호자 수준의 준비 과정이고, 상처받은 어린 부분(추방자)과 외상 기억 작업은 범위 밖이다. 규칙 5(왜·과거·기억 금지)를 참여자 쪽에서도 지킨다.",
    "strong": {
      "action": "present_focus",
      "description": "기억 서사·외상 사건 표지. 그 턴은 LLM 대신 고정 문구 depth_present를 내고, 세션에서 두 번째부터는 확인 문구와 연구자 알림으로 올린다.",
      "patterns": [
        { "id": "childhood", "re": "어릴\\s*(때|적)|어렸을\\s*(때|적)|어린\\s*시절|유년" },
        { "id": "school_years", "re": "초등학교|중학교|고등학교|유치원" },
        { "id": "age_when", "re": "\\d+\\s*살\\s*(때|무렵)|(한|두|세|네|다섯|여섯|일곱|여덟|아홉|열)\\s*살\\s*(때|무렵)" },
        { "id": "that_time", "re": "그\\s*때\\s*(너무|정말|많이|그|제가|내가)|그때\\s*(너무|정말|많이|그|제가|내가)" },
        { "id": "memory", "re": "기억이\\s*나|기억나|떠오르는\\s*기억|옛날\\s*기억" },
        { "id": "abuse", "re": "학대|폭행|폭력|맞았|때렸|혼났|버림받|따돌림|왕따|망신" },
        { "id": "trauma_word", "re": "트라우마|상처받았던|사고\\s*났" }
      ]
    },
    "weak": {
      "action": "anchor_block",
      "description": "가족·학교 같은 관계 장면 표지. LLM이 이 말을 인용해 더 파고들지 못하게만 막는다(V9).",
      "patterns": [
        { "id": "family", "re": "엄마|아빠|어머니|아버지|부모님?|할머니|할아버지|형제|언니|오빠|누나|동생" },
        { "id": "school_peer", "re": "학교|선생님|반\\s*친구|교실|친구|동료|선배|후배" },
        { "id": "past", "re": "예전에?|옛날에?|과거|그때|그\\s*때" }
      ]
    }
  }
}
