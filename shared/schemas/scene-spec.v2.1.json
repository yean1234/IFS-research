  "$defs": {
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "unitOrNull": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "hsl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h",
        "s",
        "l"
      ],
      "properties": {
        "h": {
          "$ref": "#/$defs/unit"
        },
        "s": {
          "$ref": "#/$defs/unit"
        },
        "l": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "charSpan": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "trigger",
        "charSpan",
        "rule"
      ],
      "properties": {
        "source": {
          "enum": [
            "explicit_lexicon",
            "simile_marker",
            "vad_lexicon",
            "phrase_rule",
            "fuzzy_lexicon",
            "body_part_height"
          ],
          "description": "1층 사전 / 2층 직유 / 3층 V/A/D / (v2.1) 1층 구 규칙(수치·비교·색 수식·높이어) / 자모 퍼지 매칭(확인 필요) / 신체 부위 높이 제안(_inferred 전용)"
        },
        "trigger": {
          "type": "string",
          "minLength": 1,
          "description": "확정 텍스트에서 그 값을 만든 말(charSpan 구간과 같다)"
        },
        "charSpan": {
          "$ref": "#/$defs/charSpan"
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "description": "<근거 규칙>><슬롯 경로>:<대응 키>"
        },
        "needsConfirmation": {
          "type": "boolean",
          "description": "퍼지 매칭으로 만든 값. 참여자 확인 전"
        }
      }
    },
    "provenanceList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "slotPath": {
      "enum": [
        "form.type",
        "form.posture",
        "material.color",
        "material.brightness",
        "material.saturation",
        "material.roughness",
        "material.opacity",
        "material.erosion",
        "layout.size",
        "layout.distance",
        "layout.verticalOffset",
        "motion.type",
        "motion.speed",
        "body.part",
        "body.layer"
      ]
    },
    "slotPathOrNull": {
      "enum": [
        "form.type",
        "form.posture",
        "material.color",
        "material.brightness",
        "material.saturation",
        "material.roughness",
        "material.opacity",
        "material.erosion",
        "layout.size",
        "layout.distance",
        "layout.verticalOffset",
        "motion.type",
        "motion.speed",
        "body.part",
        "body.layer",
        null
      ]
    }
  }
