{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-research.local/shared/schemas/scene-spec.v2.1.json",
  "title": "IFSSceneSpec v2.1",
  "description": "SceneSpec v2.0의 상위 호환 확장(개선 매핑 v1). v2.0 문서(specVersion 2.0.0)는 그대로 유효하다. 2.1.0 문서는 보존 필드(_context·_parts·_uncertain·_measurements·_direction·_needsConfirmation·_clauses), meta.mapping(매핑 선택·대체 기록), 새 근거 출처(phrase_rule·fuzzy_lexicon·body_part_height)를 더 가질 수 있다. 값 규칙(말하지 않은 값은 null, 값이 있으면 _provenance)은 v2.0과 같다. 근거: docs/scene-spec-mapping.md 7절, AGENTS.md 1·2.",
  "x-schemaVersion": "2.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "form",
    "material",
    "layout",
    "motion",
    "body",
    "_provenance",
    "_unmatched",
    "_unmapped",
    "_negated",
    "_alternatives",
    "_inferred"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specVersion",
        "participantId",
        "sessionId",
        "condition",
        "sourceTextHash",
        "pipeline"
      ],
      "properties": {
        "specVersion": {
          "enum": [
            "2.0.0",
            "2.1.0"
          ]
        },
        "participantId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{1,40}$",
          "description": "가명 ID. 모르면 null"
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{1,40}$"
        },
        "condition": {
          "enum": [
            "chatbot",
            "static",
            null
          ],
          "description": "유도 조건(elicitationCondition)"
        },
        "sourceTextHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "정규화한 확정 텍스트(UTF-8)의 SHA-256. charSpan도 이 텍스트 기준"
        },
        "pipeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "builder",
            "analyzer",
            "lexicons"
          ],
          "properties": {
            "builder": {
              "type": "string"
            },
            "analyzer": {
              "enum": [
                "kiwi",
                "fallback-regex"
              ]
            },
            "lexicons": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "mapping": {
          "description": "어느 매핑이 이 파일을 만들었나. v1이 예외로 실패하면 used = v0와 fallbackReason이 남는다",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested",
            "used",
            "fallbackReason"
          ],
          "properties": {
            "requested": {
              "type": "string"
            },
            "used": {
              "enum": [
                "v0",
                "v1"
              ]
            },
            "fallbackReason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "posture"
      ],
      "properties": {
        "type": {
          "description": "사전 제작 에셋 4종 중 하나. 덩어리/안개/껍질/조각",
          "enum": [
            "blob",
            "mist",
            "shell",
            "fragments",
            null
          ]
        },
        "posture": {
          "description": "자세어(웅크리다 → curled). 렌더러가 변형 프리셋으로 표현",
          "enum": [
            "bent",
            "bowed",
            "cowering",
            "crouched",
            "curled",
            "drooping",
            "hanging",
            "hiding",
            "hunched",
            "limp",
            "lying",
            "prone",
            "sagging",
            "sitting",
            "standing",
            "turned_away",
            null
          ]
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "brightness",
        "saturation",
        "roughness",
        "opacity",
        "erosion"
      ],
      "properties": {
        "color": {
          "description": "HSL, 각 0–1 (h = 색상각/360)",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hsl"
            }
          ]
        },
        "brightness": {
          "$ref": "#/$defs/unitOrNull",
          "description": "밝기·발광 0(어두움)–1(눈부심)"
        },
        "saturation": {
          "$ref": "#/$defs/unitOrNull",
          "description": "채도어(선명·탁하 …). null이 아니면 렌더러가 color.s 대신 쓴다"
        },
        "roughness": {
          "$ref": "#/$defs/unitOrNull",
          "description": "표면 거칠기 0(젖은·매끈)–1(거칠·녹슨)"
        },
        "opacity": {
          "$ref": "#/$defs/unitOrNull",
          "description": "불투명도 0(투명)–1(불투명)"
        },
        "erosion": {
          "$ref": "#/$defs/unitOrNull",
          "description": "가장자리 침식·디졸브 0(온전)–1(부서짐). 삭다·갈라지다·깨지다"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "distance",
        "verticalOffset"
      ],
      "properties": {
        "size": {
          "$ref": "#/$defs/unitOrNull",
          "description": "로그 척도 크기. 0.5 = 에셋 기본 크기(×1), 0 = ×0.25, 1 = ×4. size = 0.5 + log2(scale)/4"
        },
        "distance": {
          "$ref": "#/$defs/unitOrNull",
          "description": "참여자 머리에서 수평 거리. 0 = 최소(0.3 m), 1 = 최대(3.0 m), 선형"
        },
        "verticalOffset": {
          "$ref": "#/$defs/unitOrNull",
          "description": "높이 = 참여자 키에 대한 비율. 0 = 바닥, 1 = 정수리. 가슴 0.72"
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "speed"
      ],
      "properties": {
        "type": {
          "description": "움직임어(흔들리다 → swaying). 움직임 부정('움직임은 없어요')만 still",
          "enum": [
            "approaching",
            "churning",
            "circling",
            "collapsing",
            "drifting",
            "floating",
            "moving",
            "pounding",
            "pushing",
            "rippling",
            "rising",
            "rotating",
            "scattering",
            "settling",
            "sinking",
            "sloshing",
            "spreading",
            "still",
            "swaying",
            "trembling",
            "vibrating",
            "wriggling",
            null
          ]
        },
        "speed": {
          "$ref": "#/$defs/unitOrNull",
          "description": "0(아주 느림)–1(아주 빠름)"
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part",
        "layer"
      ],
      "properties": {
        "part": {
          "description": "참여자가 말한 신체 부위. 감정 이름에서 추론하지 않는다",
          "enum": [
            "arm",
            "back",
            "belly",
            "body",
            "chest",
            "face",
            "flank",
            "foot",
            "forehead",
            "hand",
            "head",
            "heart",
            "leg",
            "lower_back",
            "lower_belly",
            "nape",
            "shoulder",
            "skin",
            "solar_plexus",
            "throat",
            "throat_neck",
            "whole_body",
            null
          ]
        },
        "layer": {
          "description": "몸 기준 위치(안·표면·주변). 같은 줄에 신체 부위어가 있을 때만",
          "enum": [
            "inner",
            "surface",
            "surface_above",
            "around",
            "around_front",
            "around_behind",
            "around_side",
            "around_below",
            null
          ]
        }
      }
    },
    "_provenance": {
      "description": "슬롯 경로 → 그 값을 만든 근거 목록. null인 슬롯은 키가 없다",
      "type": "object",
      "propertyNames": {
        "enum": [
          "form.type",
          "form.posture",
          "material.color",
          "material.brightness",
          "material.saturation",
          "material.roughness",
          "material.opacity",
          "material.erosion",
          "layout.size",
          "layout.distance",
          "layout.verticalOffset",
          "motion.type",
          "motion.speed",
          "body.part",
          "body.layer"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/provenanceList"
      }
    },
    "_unmatched": {
      "description": "1층 사전에 없는 내용어(소실 정보). 참여자가 말했지만 시스템이 못 읽은 말",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lemma",
          "tag",
          "surface",
          "charSpan"
        ],
        "properties": {
          "lemma": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "charSpan": {
            "$ref": "#/$defs/charSpan"
          }
        }
      }
    },
    "_unmapped": {
      "description": "사전에는 있지만 v2 장면 파라미터로 옮길 곳이 없는 말(형태어 '가장자리', 자기지칭 '나' …)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lemma",
          "category",
          "value",
          "reason",
          "_provenance"
        ],
        "properties": {
          "lemma": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "value": {
            "type": "object"
          },
          "reason": {
            "enum": [
              "no_scene_param",
              "no_value_mapping",
              "no_body_part_context",
              "simile_prototype_pending",
              "idiom"
            ]
          },
          "_provenance": {
            "$ref": "#/$defs/provenance"
          }
        }
      }
    },
    "_negated": {
      "description": "부정된 말('무겁진 않아요'). 값으로 넣지 않고 기록만 한다",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lemma",
          "category",
          "_provenance"
        ],
        "properties": {
          "lemma": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "_provenance": {
            "$ref": "#/$defs/provenance"
          }
        }
      }
    },
    "_alternatives": {
      "description": "같은 슬롯의 다른 근거. lower_layer·later_mention(v2.0), lower_priority(구체어·움직임 동사·측정값에 밀림), superseded('처음엔 …했다가' 뒤 상태에 밀림), self_corrected('아 아니다'·'X보다는'), participant_uncertain('잘 모르겠어요')",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "reason",
          "_provenance"
        ],
        "properties": {
          "path": {
            "enum": [
              "form.type",
              "form.posture",
              "material.color",
              "material.brightness",
              "material.saturation",
              "material.roughness",
              "material.opacity",
              "material.erosion",
              "layout.size",
              "layout.distance",
              "layout.verticalOffset",
              "motion.type",
              "motion.speed",
              "body.part",
              "body.layer"
            ]
          },
          "value": {},
          "reason": {
            "enum": [
              "lower_layer",
              "later_mention",
              "lower_priority",
              "superseded",
              "self_corrected",
              "participant_uncertain"
            ]
          },
          "_provenance": {
            "$ref": "#/$defs/provenanceList"
          }
        }
      }
    },
    "_inferred": {
      "description": "3층(V/A/D) 제안. 값이 null인 슬롯에만 생기고, 값 자리에 들어가지 않는다(원칙 3). 렌더러는 기본적으로 쓰지 않는다",
      "type": "object",
      "propertyNames": {
        "enum": [
          "form.type",
          "form.posture",
          "material.color",
          "material.brightness",
          "material.saturation",
          "material.roughness",
          "material.opacity",
          "material.erosion",
          "layout.size",
          "layout.distance",
          "layout.verticalOffset",
          "motion.type",
          "motion.speed",
          "body.part",
          "body.layer"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "_provenance"
        ],
        "properties": {
          "value": {
            "$ref": "#/$defs/unit"
          },
          "_provenance": {
            "$ref": "#/$defs/provenanceList"
          }
        }
      }
    },
    "_context": {
      "description": "(v2.1) 범위 규칙으로 값에서 뺀 말. 회상 문장·배경 사물·자리 표지 사물의 속성어",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "charSpan",
          "reason",
          "path",
          "value",
          "rule"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "charSpan": {
            "$ref": "#/$defs/charSpan"
          },
          "reason": {
            "enum": [
              "recollection_sentence",
              "background_object",
              "background_subject",
              "landmark_object",
              "object_relative_position"
            ]
          },
          "path": {
            "$ref": "#/$defs/slotPathOrNull"
          },
          "value": {},
          "rule": {
            "type": "string"
          }
        }
      }
    },
    "_parts": {
      "description": "(v2.1) 부분(테두리·가장자리·안쪽 …)의 속성. 전체 값으로 쓰지 않은 것",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "charSpan",
          "part",
          "partClass",
          "path",
          "value",
          "rule"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "charSpan": {
            "$ref": "#/$defs/charSpan"
          },
          "part": {
            "type": [
              "string",
              "null"
            ]
          },
          "partClass": {
            "enum": [
              "outer",
              "inner",
              "detail",
              null
            ]
          },
          "path": {
            "$ref": "#/$defs/slotPath"
          },
          "value": {},
          "rule": {
            "type": "string"
          }
        }
      }
    },
    "_uncertain": {
      "description": "(v2.1) 참여자가 모른다고 말한 절. paths의 슬롯은 값을 비운다",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "charSpan",
          "paths",
          "marker"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "charSpan": {
            "$ref": "#/$defs/charSpan"
          },
          "paths": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slotPath"
            }
          },
          "marker": {
            "type": "string"
          }
        }
      }
    },
    "_measurements": {
      "description": "(v2.1) 수치·비교로 읽은 물리 크기(m). usedFor가 null이면 값으로 쓰지 않음(폭·모름)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "charSpan",
          "kind",
          "meters",
          "dimension",
          "reference",
          "usedFor"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "charSpan": {
            "$ref": "#/$defs/charSpan"
          },
          "kind": {
            "enum": [
              "number_unit",
              "reference",
              "cover"
            ]
          },
          "meters": {
            "type": "number",
            "minimum": 0
          },
          "dimension": {
            "enum": [
              "size",
              "distance",
              "width",
              "unknown"
            ]
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "usedFor": {
            "$ref": "#/$defs/slotPathOrNull"
          }
        }
      }
    },
    "_direction": {
      "description": "(v2.1) 왼쪽·오른쪽 방향어. v2에 방향 슬롯이 없어 보존만 한다",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "charSpan",
          "horizontal",
          "vertical",
          "depth"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "charSpan": {
            "$ref": "#/$defs/charSpan"
          },
          "horizontal": {
            "enum": [
              "left",
              "right",
              null
            ]
          },
          "vertical": {
            "enum": [
              "up",
              "down",
              null
            ]
          },
          "depth": {
            "enum": [
              "front",
              "behind",
              null
            ]
          }
        }
      }
    },
    "_needsConfirmation": {
      "description": "(v2.1) 퍼지 매칭으로 만든 값 — 확인 필요",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "trigger",
          "charSpan",
          "reason",
          "matched"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/slotPath"
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "charSpan": {
            "$ref": "#/$defs/charSpan"
          },
          "reason": {
            "const": "fuzzy_lexicon"
          },
          "matched": {
            "type": "string"
          }
        }
      }
    },
    "_clauses": {
      "description": "(v2.1) 확정 텍스트 전체의 절 단위 원문 색인(무손실). 각 절이 어느 슬롯 값에 쓰였는지",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "charSpan",
          "text",
          "usedFor",
          "status"
        ],
        "properties": {
          "charSpan": {
            "$ref": "#/$defs/charSpan"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "usedFor": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slotPath"
            }
          },
          "status": {
            "enum": [
              "used",
              "partly_used",
              "unused",
              "context"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "원칙 3·4: form.type가 null이면 _provenance에 없어야 하고, 값이 있으면 _provenance가 있어야 하며 _inferred에는 없어야 한다",
      "if": {
        "properties": {
          "form": {
            "properties": {
              "type": {
                "type": "null"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "_provenance": {
            "not": {
              "required": [
                "form.type"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "_provenance": {
            "required": [
              "form.type"
            ]
          },
          "_inferred": {
            "not": {
              "required": [
                "form.type"
              ]
            }
          }
        }
      }
    },
    {
      "$comment": "원칙 3·4: form.posture가 null이면 _provenance에 없어야 하고, 값이 있으면 _provenance가 있어야 하며 _inferred에는 없어야 한다",
      "if": {
        "properties": {
          "form": {
            "properties": {
              "posture": {
                "type": "null"
              }
            }
          }
        }
